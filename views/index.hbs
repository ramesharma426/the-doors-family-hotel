        </video>
        <figcaption>The garden from above, after dark</figcaption>
      </figure>
      <figure>
        <video muted loop playsinline preload="metadata" poster="assets/img/neon_sign.jpg">
          <source src="assets/video/clip_neon.mp4" type="video/mp4">
        </video>
        <figcaption>Neon nights, monsoon magic</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ================= VISIT ================= -->
<section class="visit dark" id="visit">
  <img class="deco-lizard visit-lizard" src="assets/logo/lizard_cream.png" alt="">
  <div class="section-inner">
    <p class="eyebrow" style="color:var(--gold);">Find Us</p>
    <h2 class="section-title" style="color:var(--paper);">Visit Us</h2>
    <div class="title-rule"></div>
