    <p class="team-caption">The smiling crew that keeps the plates full, the drinks cold,
    and the good times rolling &mdash; every single day.</p>
  </div>
</section>

<!-- ================= VIDEO REEL ================= -->
<section class="reel dark" id="reel">
  <div class="section-inner">
    <p class="eyebrow" style="color:var(--gold);">In Motion</p>
    <h2 class="section-title" style="color:var(--paper);">Feel The Vibe</h2>
    <div class="title-rule"></div>
    <div class="reel-grid">
      <figure>
        <video muted loop playsinline preload="metadata" poster="assets/img/live_band.jpg">
          <source src="assets/video/clip_live.mp4" type="video/mp4">
