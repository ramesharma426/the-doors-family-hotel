        </figure>
        <figure class="c-slide">
          <a class="lbx" href="assets/img/wings_mural.jpg"><img src="assets/img/wings_mural.jpg" alt="Guests posing at the angel wings mural" loading="lazy"></a>
          <figcaption>Spread your wings at The Doors mural</figcaption>
        </figure>
        <figure class="c-slide">
          <a class="lbx" href="assets/img/family_visit.jpg"><img src="assets/img/family_visit.jpg" alt="Family evening at the garden" loading="lazy"></a>
