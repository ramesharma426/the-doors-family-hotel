        </figure>
        <figure class="c-slide">
          <a class="lbx" href="assets/img/ny_trio.jpg"><img src="assets/img/ny_trio.jpg" alt="Friends dressed up for the celebration" loading="lazy"></a>
          <figcaption>Dressed up for the big night</figcaption>
        </figure>
        <figure class="c-slide">
          <a class="lbx" href="assets/img/guests.jpg"><img src="assets/img/guests.jpg" alt="Guests smiling at their table" loading="lazy"></a>
          <figcaption>Cozy corners, warm smiles</figcaption>
        </figure>
      </div>
      <div class="c-dots"></div>
    </div>
  </div>
  </div>
</section>

<!-- ================= TEAM ================= -->
<section class="team" id="team">
  <div class="section-inner">
    <p class="eyebrow">The Family Behind The Door's</p>
    <h2 class="section-title">Meet The Team</h2>
    <div class="title-rule"></div>
    <div class="carousel v2" id="car-team">
      <div class="c-track">
        <figure class="c-slide">
          <a class="lbx" href="assets/img/team.jpg"><img src="assets/img/team.jpg" alt="Service team smiling" loading="lazy"></a>
